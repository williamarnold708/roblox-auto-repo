# RobloxAutoPromo - TikTok credentials (copy to .env or set as environment variables).
# Never commit real values. Tokens obtained via `auth` are stored in the OS keyring
# (if the `keyring` package is installed) or analytics/.tokens.json (chmod 600).

# From https://developers.tiktok.com -> Manage apps -> your app
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Local OAuth redirect listener. The exact URI http://localhost:<port>/callback
# must be registered as a redirect URI for your app in the TikTok developer portal.
TIKTOK_REDIRECT_PORT=8765
# TIKTOK_REDIRECT_URI=http://localhost:8765/callback

# Optional: force the plaintext token file even if keyring is installed / choose its path
# AUTOPROMO_NO_KEYRING=1
# AUTOPROMO_TOKEN_FILE=analytics/.tokens.json

# Optional [publish] keys read from config/settings.toml (not env):
#   mode = "local" | "inbox" | "direct"
#   app_audited = false          # set true ONLY after TikTok approves your audit (direct mode)
#   privacy_level = ""           # user's explicit choice; must be in creator_info options. No default.
#   disable_comment/disable_duet/disable_stitch = false
#   is_aigc = false              # AI-generated content label
#   brand_content_toggle = false # paid partnership / branded content
#   brand_organic_toggle = false # promoting your own business/brand (e.g. your own game)
#   redirect_port = 8765, chunk_size_mb = 10, pkce_encoding = "hex"
